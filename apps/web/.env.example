# NEAR testnet account of the deployed rose-engine contract (for example engine.rose-app.testnet).
# Leave empty until the engine is deployed: the landing then shows "Protocol not deployed yet".
NEXT_PUBLIC_ENGINE_ACCOUNT=
# Deployed addresses read by the web app (apps/web/src/lib/deployment.ts). Every value is optional:
# an unset variable shows a "not deployed" state in the app and resolves the docs placeholder
# ({{ROSE_VAULT_ADDRESS}} and so on) to "(not deployed yet)".
# RoseVault on Base Sepolia (0x address).
NEXT_PUBLIC_ROSE_VAULT_ADDRESS=
# rose Test USDC on Base Sepolia (0x address).
NEXT_PUBLIC_BASE_TUSDC_ADDRESS=
# Demo token (CINDR) on Base Sepolia (0x address).
NEXT_PUBLIC_DEMO_TOKEN_ADDRESS=
# DemoStreamFaucet on Base Sepolia (0x address): "Mint me a demo vesting position".
NEXT_PUBLIC_DEMO_STREAM_FAUCET_ADDRESS=
# Engine vault on Solana devnet (MPC-derived address, path vault/sol).
NEXT_PUBLIC_SOLANA_VAULT_ADDRESS=
# Engine gas payer on Solana devnet (MPC-derived address, path gas/sol).
NEXT_PUBLIC_SOLANA_GAS_PAYER_ADDRESS=
# Demo token mint on Solana devnet.
NEXT_PUBLIC_SOLANA_DEMO_MINT=


# Optional. Absolute site URL used for metadata and Open Graph links. Defaults to the Vercel
# production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional. Base URL used by Playwright end-to-end tests. When empty, Playwright builds the app
# and starts a local server on port 3100.
PLAYWRIGHT_BASE_URL=

# Faucet (server-side, /api/faucet). Every variable here is read only on the server: never NEXT_PUBLIC_.
# Private key (0x-prefixed hex) of the Base Sepolia hot wallet that sends gas ETH to demo users.
BASE_FAUCET_PRIVATE_KEY=
# Amount of Base Sepolia ETH sent per request, in wei. Defaults to 2000000000000000 (0.002 ETH).
BASE_FAUCET_ETH_WEI=
# Base Sepolia JSON-RPC endpoint used by the faucet. Defaults to https://sepolia.base.org.
BASE_SEPOLIA_RPC_URL=
# Secret key of the Solana devnet hot wallet (64-byte JSON array as written by solana-keygen, or base58).
SOLANA_FAUCET_SECRET_KEY=
# Lamports sent per request. Defaults to 50000000 (0.05 SOL).
SOLANA_FAUCET_LAMPORTS=
# Solana devnet JSON-RPC endpoint used by the faucet. Defaults to https://api.devnet.solana.com.
SOLANA_RPC_URL=
# NEAR testnet account helper that creates and funds demo accounts (the service near-cli-rs uses).
# Defaults to https://helper.nearprotocol.com/account; no NEAR key is kept on the server.
NEAR_FAUCET_HELPER_URL=
# Random secret (32+ bytes) signing the rose_faucet rate-limit cookie; the faucet refuses to run without it.
FAUCET_COOKIE_SECRET=
