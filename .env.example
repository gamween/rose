# rose environment variables. Real values live outside git: ~/.config/rose/*.env locally,
# Vercel environment variables for the deployed app. Testnet only.

# Base Sepolia deployments (Foundry scripts in contracts/evm/script)
# Private key of the account that broadcasts deployments (pass with --private-key, never commit).
EVM_DEPLOYER_PRIVATE_KEY=
# MPC-derived Ethereum address of the engine for path "vault/base" (domain 0); RoseVault's fixed signer.
ROSE_VAULT_SIGNER=
# Name and ticker of the fictional demo token.
DEMO_TOKEN_NAME=
DEMO_TOKEN_SYMBOL=
