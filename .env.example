# rose environment variables. Real values live outside git: ~/.config/rose/*.env locally,
# Vercel environment variables for the deployed app. Testnet only. Every variable the code reads is
# listed here; apps/web/.env.example repeats the web app's subset for `apps/web/.env.local`.

# Base Sepolia deployments (Foundry scripts in contracts/evm/script, run by scripts/deploy-base.sh)
# Private key of the account that broadcasts deployments. Keep it in ~/.config/rose/evm-deployer.env,
# never in git: the scripts hand it to forge and cast through an encrypted keystore
# (scripts/evm-keystore.ts), never on a command line.
EVM_DEPLOYER_PRIVATE_KEY=
# MPC-derived Ethereum address of the engine for path "vault/base" (domain 0); RoseVault's fixed
# signer. Set by scripts/deploy-base.sh from scripts/derive-vault-signer.sh.
ROSE_VAULT_SIGNER=
# Name and ticker of the fictional demo token (scripts/deploy-base.sh sets Cindral and CINDR).
DEMO_TOKEN_NAME=
DEMO_TOKEN_SYMBOL=

# Deployed addresses read by the web app (apps/web/src/lib/deployment.ts). Every value is optional:
# an unset variable shows a "not deployed" state in the app and resolves the docs placeholder
# ({{ENGINE_ACCOUNT}}, {{ROSE_VAULT_ADDRESS}} and so on) to "(not deployed yet)".
# scripts/deploy-engine.sh writes the whole block to deployments/<engine>.env.
# NEAR testnet account of the deployed rose-engine contract (for example engine-v2.rose-app.testnet).
NEXT_PUBLIC_ENGINE_ACCOUNT=
# RoseVault on Base Sepolia (0x address).
NEXT_PUBLIC_ROSE_VAULT_ADDRESS=
# rose Test USDC on Base Sepolia (0x address).
NEXT_PUBLIC_BASE_TUSDC_ADDRESS=
# Demo token (CINDR) on Base Sepolia (0x address).
NEXT_PUBLIC_DEMO_TOKEN_ADDRESS=
# DemoStreamFaucet on Base Sepolia (0x address): "Mint me a demo vesting position".
NEXT_PUBLIC_DEMO_STREAM_FAUCET_ADDRESS=
# Engine vault on Solana devnet (MPC-derived address, path vault/sol).
NEXT_PUBLIC_SOLANA_VAULT_ADDRESS=
# Engine gas payer on Solana devnet (MPC-derived address, path gas/sol).
NEXT_PUBLIC_SOLANA_GAS_PAYER_ADDRESS=
# Demo token mint on Solana devnet (scripts/seed.ts `summary` writes it).
NEXT_PUBLIC_SOLANA_DEMO_MINT=
# Public URL of the source repository; the footer and the command palette link to it only when set
# (leave empty while the repository is private: GitHub answers 404 to visitors).
NEXT_PUBLIC_REPOSITORY_URL=

# Web app metadata and tests
# Optional. Absolute site URL used for metadata and Open Graph links. Defaults to
# VERCEL_PROJECT_PRODUCTION_URL (set by Vercel itself, never by hand), then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Optional. Base URL the Playwright end-to-end tests run against. When empty, Playwright builds the
# app and starts a local server on port 3100.
PLAYWRIGHT_BASE_URL=
# Optional. Set to 1 to run apps/web/e2e/live-smoke.spec.ts against the live testnets (skipped
# otherwise; every other end-to-end test mocks the chains).
ROSE_LIVE_SMOKE=
# Optional. Directory where the app-advance, app-issuer and app-portfolio end-to-end specs save
# their review screenshots at 1470 px and 375 px; no screenshots when unset.
ROSE_SCREENSHOT_DIR=
# Optional. The same for apps/web/e2e/app-deposit.spec.ts, which reads this other name.
SCREENSHOT_DIR=
# Also read, but set by the tooling and never in an env file: CI (set by CI providers; Playwright
# then forbids `test.only`, retries once and never reuses a server) and NODE_ENV (set by Next.js,
# `production` in builds; the faucet's cookie is Secure only then).

# Faucet (server-side, /api/faucet). Every variable here is read only on the server: never NEXT_PUBLIC_.
# Private key (0x-prefixed hex) of the Base Sepolia hot wallet that sends gas ETH to demo users.
BASE_FAUCET_PRIVATE_KEY=
# Amount of Base Sepolia ETH sent per request, in wei. Defaults to 2000000000000000 (0.002 ETH).
BASE_FAUCET_ETH_WEI=
# Base Sepolia JSON-RPC endpoint of the faucet and of the scripts. Defaults to https://sepolia.base.org.
BASE_SEPOLIA_RPC_URL=
# Secret key of the Solana devnet hot wallet (64-byte JSON array as written by solana-keygen, or base58).
SOLANA_FAUCET_SECRET_KEY=
# Lamports sent per request. Defaults to 50000000 (0.05 SOL).
SOLANA_FAUCET_LAMPORTS=
# Whole demo tokens (NEXT_PUBLIC_SOLANA_DEMO_MINT) the "solana-demo-token" action sends per request, from the
# hot wallet's own token account (filled from the mint authority). Defaults to 1000, what a demo Streamflow position locks.
SOLANA_FAUCET_DEMO_TOKENS=
# Solana devnet JSON-RPC endpoint of the faucet and of the scripts. Defaults to
# https://api.devnet.solana.com.
SOLANA_RPC_URL=
# NEAR testnet account helper that creates and funds demo accounts (the service near-cli-rs uses).
# Defaults to https://helper.nearprotocol.com/account.
NEAR_FAUCET_HELPER_URL=
# Optional fallback when the helper is rate limited or down: a funded testnet account that creates
# the demo account through the `testnet` registrar (`create_account`). Both must be set to enable it.
NEAR_FAUCET_ACCOUNT_ID=
# Its full-access key, `ed25519:<base58 secret>` as in the near-cli legacy keychain.
NEAR_FAUCET_PRIVATE_KEY=
# yoctoNEAR given to each account the funder creates. Defaults to 1000000000000000000000000 (1 NEAR).
NEAR_FAUCET_YOCTO=
# NEAR testnet JSON-RPC endpoint. The faucet (account checks, funder caps and transactions) and the
# scripts (scripts/*.sh, *.ts, *.mjs) default to https://test.rpc.fastnear.com (the TypeScript
# scripts fall back to https://near-testnet.drpc.org).
NEAR_RPC_URL=
# Random secret (32+ bytes) signing the rose_faucet rate-limit cookie; the faucet refuses to run without it.
FAUCET_COOKIE_SECRET=
# Global sends per hot wallet for all visitors together, per rolling hour and per rolling day,
# counted from each hot wallet's own on-chain history (no shared store is needed). Defaults:
# Base 5 and 15, Solana SOL 3 and 6, Solana demo tokens 3 and 6 (counted on the demo token
# treasury account), NEAR funder fallback 3 and 6 (the public helper is not capped here).
BASE_FAUCET_HOURLY_CAP=
BASE_FAUCET_DAILY_CAP=
SOLANA_FAUCET_HOURLY_CAP=
SOLANA_FAUCET_DAILY_CAP=
SOLANA_DEMO_TOKEN_FAUCET_HOURLY_CAP=
SOLANA_DEMO_TOKEN_FAUCET_DAILY_CAP=
NEAR_FAUCET_HOURLY_CAP=
NEAR_FAUCET_DAILY_CAP=

# Scripts (scripts/*.sh, *.ts, *.mjs). They also honor NEAR_RPC_URL, BASE_SEPOLIA_RPC_URL and
# SOLANA_RPC_URL above.
# Directory of the local key files, mode 700, each file mode 600. Defaults to ~/.config/rose.
#   evm-deployer.env         EVM_DEPLOYER_PRIVATE_KEY: Base deployer, Cindral treasury on Base
#   <name>.env               EVM_PRIVATE_KEY of another EVM holder (scripts/e2e-base-tender.sh --evm-env <name>)
#   keystores/<name>.json    encrypted keystore of <name>.env, with keystores/<name>.password (written by scripts/evm-keystore.ts)
#   solana-ops.json          Solana devnet ops key: Cindral treasury on Solana, funds the Solana scripts
#   solana-holder.json       Solana holder of scripts/e2e-solana-stream.mjs (generated)
#   seed-accounts.json       NEAR, EVM and Solana keys of the demo cast (generated by scripts/seed.ts)
#   seed-orders/<engine>.json  sealed orders until they are opened (directory mode 700)
# NEAR keys are read from the near-cli legacy keychain, ~/.near-credentials/testnet/.
ROSE_CONFIG_DIR=
# Parent of the demo cast's NEAR accounts and funder of the seed and live runs; its key must be in
# the legacy keychain. Defaults to rose-app.testnet; another root gets its own cast journal
# (deployments/e2e/cindral.<root>.json).
ROSE_ROOT_ACCOUNT=

# Rust tests (cargo test)
# Set to 1 to run the NEAR sandbox suites (contracts/engine/tests/sandbox_*.rs); they print a skip
# line and pass otherwise. Run them one suite at a time with -- --test-threads=1.
ROSE_SANDBOX=
# Set to 1 to rewrite contracts/engine/tests/vectors/{clearing,unlock}.json from the engine instead
# of comparing with them (after an intended engine change).
ROSE_UPDATE_VECTORS=
