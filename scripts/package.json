{
  "name": "@rose/scripts",
  "private": true,
  "description": "Deployment, demo seed and real-testnet end-to-end scripts. The TypeScript scripts run under Node 22.18 or later (native type stripping): `node scripts/seed.ts`.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.mjs.json",
    "lint": "eslint .",
    "test": "node --test lib/*.test.ts",
    "seed": "node seed.ts",
    "e2e:live": "node e2e-live.ts"
  },
  "dependencies": {
    "@rose/ibe-wasm": "workspace:*",
    "@rose/sdk": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@streamflow/stream": "13.4.0",
    "bn.js": "5.2.3",
    "near-api-js": "7.4.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bn.js": "5.2.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
