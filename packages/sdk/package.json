{
  "name": "@rose/sdk",
  "version": "0.1.0",
  "description": "rose TypeScript SDK: exact integer ports of the rose-engine unlock math and uniform-price clearing",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./clearing": {
      "types": "./src/clearing.ts",
      "import": "./dist/clearing.js",
      "default": "./dist/clearing.js"
    },
    "./math": {
      "types": "./src/math.ts",
      "import": "./dist/math.js",
      "default": "./dist/math.js"
    },
    "./unlock": {
      "types": "./src/unlock.ts",
      "import": "./dist/unlock.js",
      "default": "./dist/unlock.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "abis": "node scripts/extract-abis.mjs",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@solana/web3.js": "1.99.0",
    "buffer": "6.0.3",
    "viem": "2.57.16"
  }
}
