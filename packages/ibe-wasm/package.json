{
  "name": "@rose/ibe-wasm",
  "version": "0.1.0",
  "description": "rose-ibe compiled to WebAssembly (wasm-bindgen) with typed encryptBid and decryptBid wrappers for the browser",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./rose_ibe_bg.wasm": "./pkg/rose_ibe_bg.wasm"
  },
  "files": [
    "dist",
    "pkg",
    "src"
  ],
  "scripts": {
    "build:wasm": "./build-wasm.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/pkg && cp pkg/rose_ibe.js pkg/rose_ibe.d.ts pkg/rose_ibe_bg.wasm dist/pkg/",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
